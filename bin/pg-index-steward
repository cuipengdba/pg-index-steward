#!/usr/bin/env python3
"""Collect PostgreSQL statistics and run a bounded index-maintenance cycle."""

import argparse
import ctypes
import datetime as dt
import fcntl
import hashlib
import json
import os
import re
import shutil
import sys
import time
from itertools import islice
from pathlib import Path


SCHEMA = 'index_steward'
MAX_STATEMENTS = 300
MIN_CALLS = 20
MIN_TOTAL_MS = 1000
MIN_TABLE_BYTES = 1024 * 1024
MIN_ROWS = 1000
IDLE_DAYS = 60
MAX_GAP_HOURS = 24
OBS_MIN_CALLS = 100
KEY_TYPES = {16, 20, 21, 23, 25, 26, 700, 701, 1042, 1043, 1082, 1083,
             1114, 1184, 1186, 1266, 1700, 2950, 3220}
MIB = 1024 * 1024
MIN_DDL_WINDOW_SECONDS = 30


class DatabaseError(RuntimeError):
    def __init__(self, message, sqlstate=None):
        super().__init__(message)
        self.sqlstate = sqlstate


def literal(value):
    if value is None:
        return 'NULL'
    if isinstance(value, bool):
        return 'TRUE' if value else 'FALSE'
    if isinstance(value, int):
        return str(value)
    return "pg_catalog.convert_from(pg_catalog.decode('%s','hex'),'UTF8')" % str(value).encode().hex()


def json_value(value):
    return literal(json.dumps(value, ensure_ascii=True, allow_nan=False)) + '::jsonb'


def identifier(name):
    return '"' + name.replace('"', '""') + '"'


def relation(schema, name):
    return identifier(schema) + '.' + identifier(name)


class Database:
    def __init__(self, library, conninfo):
        self.library = library
        self.lib = ctypes.CDLL(str(library))
        signatures = {
            'PQconnectdb': (ctypes.c_void_p, (ctypes.c_char_p,)),
            'PQstatus': (ctypes.c_int, (ctypes.c_void_p,)),
            'PQsetClientEncoding': (ctypes.c_int, (ctypes.c_void_p, ctypes.c_char_p)),
            'PQerrorMessage': (ctypes.c_char_p, (ctypes.c_void_p,)),
            'PQfinish': (None, (ctypes.c_void_p,)),
            'PQexec': (ctypes.c_void_p, (ctypes.c_void_p, ctypes.c_char_p)),
            'PQresultStatus': (ctypes.c_int, (ctypes.c_void_p,)),
            'PQresultErrorField': (ctypes.c_char_p, (ctypes.c_void_p, ctypes.c_int)),
            'PQntuples': (ctypes.c_int, (ctypes.c_void_p,)),
            'PQgetvalue': (ctypes.c_char_p, (ctypes.c_void_p, ctypes.c_int, ctypes.c_int)),
            'PQclear': (None, (ctypes.c_void_p,)),
        }
        for name, (result, arguments) in signatures.items():
            fn = getattr(self.lib, name)
            fn.restype, fn.argtypes = result, arguments
        self.conn = self.lib.PQconnectdb(conninfo.encode())
        if not self.conn:
            raise DatabaseError('libpq could not allocate a connection')
        if self.lib.PQstatus(self.conn) or self.lib.PQsetClientEncoding(self.conn, b'UTF8'):
            error = self.error()
            self.close()
            raise DatabaseError(error)
        self.execute("SET search_path = pg_catalog; SET application_name = 'pg-index-steward'; "
                     "SET statement_timeout = '15s'; SET lock_timeout = '2s'")

    def error(self):
        return self.lib.PQerrorMessage(self.conn).decode(errors='replace').strip()

    def close(self):
        self.lib.PQfinish(self.conn)

    def execute(self, sql):
        result = self.lib.PQexec(self.conn, sql.encode())
        if not result:
            raise DatabaseError(self.error())
        try:
            if self.lib.PQresultStatus(result) not in (1, 2):
                code = self.lib.PQresultErrorField(result, ord('C'))
                raise DatabaseError(self.error(), code.decode() if code else None)
            return [self.lib.PQgetvalue(result, row, 0).decode()
                    for row in range(self.lib.PQntuples(result))]
        finally:
            self.lib.PQclear(result)

    def rows(self, sql):
        return [json.loads(row) for row in self.execute(f'SELECT row_to_json(r) FROM ({sql}) r')]

    def one(self, sql):
        rows = self.rows(sql)
        return rows[0] if rows else None


def settings(db):
    return db.one(f"""SELECT s.*, current_setting('data_directory') AS data_directory,
                         EXTRACT(epoch FROM clock_timestamp())::float8 AS now_epoch,
                         to_char(clock_timestamp(),'HH24:MI:SS') AS local_time,
                         pg_is_in_recovery() AS recovery,
                         current_setting('transaction_read_only') = 'on' AS read_only
                  FROM {SCHEMA}.settings() s""")


def seconds_remaining(window, clock):
    def seconds(value):
        h, m, *s = map(int, value.split(':'))
        return h * 3600 + m * 60 + (s[0] if s else 0)

    start, end = map(seconds, window.split('-'))
    now = seconds(clock)
    if start < end and start <= now < end:
        return end - now
    if end < start and now >= start:
        return 86400 - now + end
    if end < start and now < end:
        return end - now
    return 0


def extension_locations(db):
    row = db.one("""SELECT n.nspname AS ns FROM pg_extension e JOIN pg_namespace n ON n.oid=e.extnamespace
                    WHERE e.extname='pg_stat_statements'""")
    return relation(row['ns'], 'pg_stat_statements'), relation(row['ns'], 'pg_stat_statements_info')


def usage_counters(db, qstats, info):
    return db.rows(f"""SELECT s.userid, s.queryid, s.toplevel, s.calls,
                              s.total_exec_time AS elapsed, s.shared_blks_read AS reads,
                              s.shared_blks_hit AS hits, s.temp_blks_written AS temporary,
                              s.total_plan_time AS planning, s.plans, s.rows AS result_rows,
                              s.wal_bytes AS wal_bytes,
                              COALESCE((to_jsonb(s)->>'shared_blk_read_time')::float8,
                                       (to_jsonb(s)->>'blk_read_time')::float8) AS shared_read_ms,
                              EXTRACT(epoch FROM statement_timestamp())::float8 AS sampled_epoch,
                              i.stats_reset::text AS reset_marker, i.dealloc AS dealloc,
                              to_jsonb(s)->>'stats_since' AS stats_since,
                              old.snapshot AS previous
                       FROM {qstats} s CROSS JOIN {info} i
                       LEFT JOIN {SCHEMA}.workload old USING (userid,queryid,toplevel)
                       WHERE s.dbid=(SELECT oid FROM pg_database WHERE datname=current_database())
                         AND s.queryid IS NOT NULL AND s.calls > 0
                       ORDER BY s.total_exec_time - CASE
                           WHEN old.snapshot->>'reset_marker' = i.stats_reset::text
                            AND s.total_exec_time >= (old.snapshot->>'elapsed')::float8
                           THEN (old.snapshot->>'elapsed')::float8 ELSE 0 END DESC
                       LIMIT {MAX_STATEMENTS}""")


def workload(db, qstats, info):
    changes = []
    snapshots = []
    for row in usage_counters(db, qstats, info):
        old = row.pop('previous')
        snapshots.append((row['userid'], row['queryid'], row['toplevel'], row))
        if not old or any(old.get(k) != row[k] for k in ('reset_marker', 'dealloc', 'stats_since')):
            continue
        counters = ('calls', 'elapsed', 'reads', 'hits', 'temporary')
        delta = {k: row[k] - old[k] for k in counters}
        if delta['calls'] > 0 and min(delta.values()) >= 0:
            for k in ('planning', 'plans', 'result_rows', 'wal_bytes', 'shared_read_ms'):
                delta[k] = max(0, (row[k] or 0) - (old.get(k, row[k]) or 0))
            delta['period_seconds'] = max(0, row['sampled_epoch'] - old.get('sampled_epoch', row['sampled_epoch']))
            changes.append({**row, **delta})
    if snapshots:
        values = ','.join(f'({u}::oid,{q}::bigint,{literal(top)},{json_value(v)})' for u, q, top, v in snapshots)
        db.execute(f"""INSERT INTO {SCHEMA}.workload VALUES {values}
                        ON CONFLICT (userid,queryid,toplevel) DO UPDATE SET snapshot=excluded.snapshot""")
    return sorted(changes, key=lambda x: x['elapsed'], reverse=True)


def candidate_shape(db, qstats, delta):
    try:
        row = db.one(f"""SELECT {SCHEMA}.candidates(query) AS candidates FROM {qstats}
                WHERE userid={delta['userid']} AND queryid={delta['queryid']}
                  AND dbid=(SELECT oid FROM pg_database WHERE datname=current_database())
                  AND toplevel={literal(delta['toplevel'])} AND query IS NOT NULL""")
        return row['candidates'] if row else []
    except DatabaseError:
        return []


def record_diagnostics(db, qstats, deltas):
    values = []
    waits = {}
    for row in db.rows("""SELECT usesysid AS userid,query_id,wait_event_type,count(*) AS samples
            FROM pg_stat_activity WHERE datname=current_database() AND pid<>pg_backend_pid()
            AND state='active' AND query_id IS NOT NULL AND wait_event_type IS NOT NULL
            GROUP BY usesysid,query_id,wait_event_type"""):
        waits.setdefault((row['userid'], row['query_id']), {})[row['wait_event_type']] = row['samples']
    io_tracking = db.one("SELECT current_setting('track_io_timing')='on' AS enabled")['enabled']
    for position, delta in enumerate(deltas):
        shape = candidate_shape(db, qstats, delta) if position < 30 or not delta['toplevel'] and position < 100 else []
        delta['candidate_shape'] = shape
        wait = waits.get((delta['userid'], delta['queryid']), {}) if delta['toplevel'] else {}
        dimensions = {'planning_observed': delta['plans'] > 0,
                      'shared_read_ms': delta['shared_read_ms'] if io_tracking else None,
                      'period_seconds': delta['period_seconds'], 'wait_types': wait,
                      'wait_samples': sum(wait.values())}
        tables = {(s['schema'], s['table']) for s in shape if not s.get('advisory')}
        if len(tables) == 1 and len(shape) == 1:
            schema, table = next(iter(tables))
            dimensions['relation'] = {'schema_name': schema, 'table_name': table,
                'shape': json.dumps([sorted(shape[0]['eq']), shape[0]['range']], ensure_ascii=False)}
        category = ('spill' if delta['temporary'] > 0 else
                    'planning' if delta['planning'] > delta['elapsed'] / 2 else
                    'nested' if not delta['toplevel'] else
                    'frequent_lookup' if delta['result_rows'] <= delta['calls'] and delta['calls'] >= MIN_CALLS else 'execution')
        values.append(f"({int(delta['userid'])}::oid,{delta['queryid']}::bigint,{literal(delta['toplevel'])},"
             + ','.join(['clock_timestamp()', str(delta['elapsed']), str(delta['planning']),
             str(delta['calls']), str(delta['plans']), str(delta['reads'] + delta['hits']),
             str(delta['temporary']), literal(category), json_value(dimensions)]) + ')')
    if values:
        db.execute(f"""INSERT INTO {SCHEMA}.query_diagnostics VALUES {','.join(values)}
                       ON CONFLICT(userid,queryid,toplevel) DO UPDATE SET
                       sampled_at=excluded.sampled_at,elapsed_ms=excluded.elapsed_ms,
                       planning_ms=excluded.planning_ms,calls=excluded.calls,plans=excluded.plans,
                       shared_blocks=excluded.shared_blocks,temp_blocks=excluded.temp_blocks,category=excluded.category,
                       dimensions=excluded.dimensions""")


def eligible_table(db, schema, name):
    target = db.one(f"""SELECT c.oid, c.relname, n.nspname, c.reltuples, pg_relation_size(c.oid) AS bytes,
                            c.relpages
                     FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace
                     WHERE n.nspname={literal(schema)} AND c.relname={literal(name)}
                       AND c.relkind='r' AND c.relpersistence='p' AND NOT c.relispartition
                       AND c.reltablespace=0 AND NOT c.relrowsecurity
                       AND n.nspname NOT IN ('information_schema','{SCHEMA}') AND n.nspname !~ '^pg_'
                       AND NOT EXISTS (SELECT FROM pg_inherits h WHERE h.inhparent=c.oid OR h.inhrelid=c.oid)
                       AND NOT EXISTS (SELECT FROM pg_depend d WHERE d.classid='pg_class'::regclass
                                       AND d.objid=c.oid AND d.deptype='e')""")
    if target and not extension_managed(db, target['oid'], schema, name):
        return target
    return None


def extension_managed(db, oid, schema, name):
    extensions = db.one("""SELECT EXISTS(SELECT FROM pg_extension WHERE extname='citus') AS citus,
                                  EXISTS(SELECT FROM pg_extension WHERE extname='timescaledb') AS timescale""")
    if extensions['citus'] and db.one(f"SELECT EXISTS(SELECT FROM pg_catalog.pg_dist_partition WHERE logicalrelid={oid}) AS hit")['hit']:
        return True
    return extensions['timescale'] and db.one(f"""SELECT EXISTS(SELECT FROM timescaledb_information.hypertables
         WHERE hypertable_schema={literal(schema)} AND hypertable_name={literal(name)}) AS hit""")['hit']


def table_keys(db, target, parsed):
    rows = db.rows(f"""SELECT a.attname, a.attnum, a.atttypid::bigint AS atttypid, COALESCE(s.n_distinct,0) AS nd,
                              COALESCE(s.null_frac,0) AS null_fraction
                       FROM pg_attribute a JOIN pg_class c ON c.oid=a.attrelid
                       JOIN pg_namespace n ON n.oid=c.relnamespace
                       LEFT JOIN pg_stats s ON s.schemaname=n.nspname AND s.tablename=c.relname
                                            AND s.attname=a.attname AND NOT s.inherited
                       WHERE a.attrelid={target['oid']} AND a.attnum>0 AND NOT a.attisdropped""")
    found = {r['attname']: r for r in rows if r['atttypid'] in KEY_TYPES and r['nd'] != 0}
    eq = [found[col] for col in parsed['eq'] if col in found]
    eq.sort(key=lambda x: (-(x['nd'] if x['nd'] > 0 else -x['nd'] * target['reltuples']), x['attnum']))
    keys = eq[:2]
    ranged = found.get(parsed['range'])
    if ranged and ranged not in keys:
        keys.append(ranged)
    if not keys:
        return []
    distinct = max((x['nd'] if x['nd'] > 0 else -x['nd'] * target['reltuples']) for x in keys)
    return [x['attname'] for x in keys] if distinct >= 10 else []


def rank_portfolio(proposals):
    """Assign shared workload once per table so overlapping candidates do not dominate."""
    outstanding = list(proposals.items())
    ranked = []
    served = set()
    while outstanding:
        def marginal(candidate):
            (table_oid, _), detail = candidate
            return sum(sample['elapsed'] for sample in detail['samples']
                       if (table_oid, sample['userid'], sample['queryid'], sample['toplevel']) not in served)

        best = max(outstanding, key=lambda item: (not item[1]['advisory'], marginal(item),
                                                  len(item[1]['samples']), -len(item[1]['keys'])))
        outstanding.remove(best)
        (table_oid, _), detail = best
        detail['score'] = marginal(best)
        if not detail['advisory']:
            served.update((table_oid, sample['userid'], sample['queryid'], sample['toplevel']) for sample in detail['samples'])
        ranked.append(best)
    return ranked


def advisory_variants(db, target, detail):
    qualified = relation(detail['schema'], detail['table'])
    keys = ', '.join(identifier(key) for key in detail['keys'])
    create = f'CREATE INDEX CONCURRENTLY ON {qualified} ({keys})'
    variants = []
    # Explicit registered projections can justify a covering alternative. Only
    # selected, short scalar columns are considered, and the variant is advisory.
    for row in db.rows(f"""SELECT a.attname FROM pg_attribute a
          WHERE a.attrelid={int(target)} AND a.attnum>0 AND NOT a.attisdropped
            AND a.attlen BETWEEN 1 AND 8
            AND EXISTS(SELECT FROM {SCHEMA}.plan_samples p WHERE p.table_oid=a.attrelid
              AND substring(p.statement FROM '(?i)^\\s*select\\s+([a-z_][a-z0-9_]*)\\s+from\\s+')=a.attname)
          ORDER BY a.attnum LIMIT 4"""):
        col = row['attname']
        if col not in detail['keys']:
            variants.append({'include': [col], 'ddl_preview': f'{create} INCLUDE ({identifier(col)})'})
            break
    # Non-null partial indexes can serve strict equality/range predicates.
    # A substantial null fraction is required before recommending the variant.
    col = detail['keys'][0]
    stats = db.one(f"""SELECT null_frac FROM pg_stats WHERE schemaname={literal(detail['schema'])}
               AND tablename={literal(detail['table'])} AND attname={literal(col)} AND NOT inherited""")
    if stats and stats['null_frac'] >= .3:
        predicate = f'{identifier(col)} IS NOT NULL'
        variants.append({'predicate': predicate, 'ddl_preview': f'{create} WHERE {predicate}'})
    return create, variants


def covered(db, table_oid, keys):
    key_sql = ','.join(literal(key) for key in keys)
    return db.one(f"""SELECT EXISTS(
                SELECT FROM pg_index i JOIN pg_class c ON c.oid=i.indexrelid
                JOIN pg_am am ON am.oid=c.relam
                WHERE i.indrelid={table_oid} AND i.indisvalid AND i.indislive
                  AND am.amname='btree' AND i.indpred IS NULL AND i.indnkeyatts >= {len(keys)}
                  AND ARRAY(SELECT a.attname::text FROM unnest(i.indkey) WITH ORDINALITY k(attnum, pos)
                            LEFT JOIN pg_attribute a ON a.attrelid=i.indrelid AND a.attnum=k.attnum
                            JOIN pg_opclass op ON op.oid=i.indclass[k.pos::int-1] AND op.opcdefault
                            WHERE k.pos <= {len(keys)} AND i.indcollation[k.pos::int-1]=a.attcollation
                            ORDER BY k.pos)=ARRAY[{key_sql}]::text[]
              ) AS covered""")['covered']


def upsert_job(db, action, target, signature, detail):
    rows = db.execute(f"""WITH affected AS (INSERT INTO {SCHEMA}.jobs(action,target,signature,detail,created_at,updated_at)
                   SELECT {literal(action)},{target},{literal(signature)},{json_value(detail)},statement_timestamp(),statement_timestamp()
                   WHERE NOT EXISTS (SELECT FROM {SCHEMA}.jobs j WHERE j.action={literal(action)}
                     AND j.target={target} AND j.signature={literal(signature)}
                     AND ((j.state='failed' AND j.reason='retry_limit') OR
                          (j.state IN ('failed','cancelled') AND j.updated_at>clock_timestamp()-interval '7 days')))
                   AND ({literal(action)}<>'create' OR NOT EXISTS (
                       SELECT FROM {SCHEMA}.jobs build JOIN {SCHEMA}.verdicts v ON v.job_id=build.id
                       WHERE build.target={target} AND build.signature={literal(signature)}
                         AND v.state='rolled_back' AND v.updated_at>clock_timestamp()-interval '30 days'))
                   AND ({literal(action)}<>'create' OR NOT EXISTS (
                       SELECT FROM {SCHEMA}.jobs retired
                       WHERE retired.action='drop' AND retired.state='done' AND retired.reason='idle'
                         AND retired.detail->>'name'={literal(detail.get('index'))}
                         AND retired.detail->>'schema'={literal(detail.get('schema'))}
                         AND retired.updated_at>clock_timestamp()-interval '7 days'))
                   ON CONFLICT (action,target,signature) WHERE state IN ('queued','running')
                   DO UPDATE SET detail=excluded.detail,evidence_at=clock_timestamp(),updated_at=clock_timestamp()
                   WHERE jobs.state='queued' RETURNING id, created_at=updated_at AS inserted)
                   SELECT row_to_json(affected) FROM affected""")
    added = json.loads(rows[0]) if rows else None
    if added and added['inserted']:
        event(db, 'queued', {'id': added['id'], 'action': action}, 'new_candidate')


def hypothetical_probe(db, detail):
    """Plan a generated single-table probe in this private backend."""
    qualified_table = relation(detail['schema'], detail['table'])
    columns = ', '.join(identifier(key) for key in detail['keys'])
    terms = ' AND '.join(f'{identifier(key)} = ${number}' for number, key in enumerate(detail['keys'], 1))
    arguments = ','.join(['NULL'] * len(detail['keys']))
    explain = f'EXPLAIN (FORMAT JSON) EXECUTE steward_probe({arguments})'

    def plan():
        db.execute(f'PREPARE steward_probe AS SELECT * FROM {qualified_table} WHERE {terms}')
        try:
            return json.loads(db.execute(explain)[0])[0]['Plan']
        finally:
            db.execute('DEALLOCATE steward_probe')

    db.execute("SET plan_cache_mode='force_generic_plan'; SET statement_timeout='3s'")
    try:
        baseline = plan()
        created = db.one(f"SELECT indexname FROM {SCHEMA}.hypo_create({literal(f'CREATE INDEX ON {qualified_table} USING btree ({columns})')})")
        proposed = plan()
        return {'method': 'generated_generic_equality_probe', 'before_cost': baseline['Total Cost'],
                'after_cost': proposed['Total Cost'], 'uses_candidate': created['indexname'] in json.dumps(proposed)}
    except DatabaseError as error:
        return {'method': 'generated_generic_equality_probe', 'error': error.sqlstate or 'unavailable'}
    finally:
        db.execute(f"SELECT {SCHEMA}.hypo_reset(); RESET plan_cache_mode; SET statement_timeout='15s'")


def measured_plans(db, table_oid, detail):
    samples = db.rows(f"SELECT label,statement,parameters FROM {SCHEMA}.plan_samples "
                      f"WHERE table_oid={int(table_oid)} ORDER BY id LIMIT 4")
    evidence = []
    for sample in samples:
        try:
            db.execute("BEGIN READ ONLY; SET LOCAL statement_timeout='3s'")
            if not db.one(f"SELECT {SCHEMA}.valid_plan_sample({literal(sample['statement'])}) AS valid")['valid']:
                continue
            arguments = ','.join('NULL' if item is None else 'E\'' + item.replace('\\', '\\\\').replace("'", "''") + "'"
                                 for item in sample['parameters'])
            invocation = f"steward_sample({arguments})" if arguments else 'steward_sample'

            def plan(mode):
                db.execute(f"SET LOCAL plan_cache_mode='{mode}'")
                db.execute('PREPARE steward_sample AS ' + sample['statement'])
                try:
                    return json.loads(db.execute(f'EXPLAIN (FORMAT JSON) EXECUTE {invocation}')[0])[0]['Plan']
                finally:
                    db.execute('DEALLOCATE steward_sample')

            modes = ('force_generic_plan','force_custom_plan')
            baseline = {mode: plan(mode) for mode in modes}
            table = relation(detail['schema'], detail['table'])
            columns = ','.join(identifier(key) for key in detail['keys'])
            created = db.one(f"SELECT indexrelid,indexname FROM {SCHEMA}.hypo_create({literal(f'CREATE INDEX ON {table} ({columns})')})")
            size = db.one(f"SELECT {SCHEMA}.hypo_size({int(created['indexrelid'])}::oid) AS bytes")['bytes']
            for mode in modes:
                proposed = plan(mode)
                evidence.append({'sample': sample['label'], 'mode': mode, 'estimated_bytes': size,
                    'before_cost': baseline[mode]['Total Cost'], 'after_cost': proposed['Total Cost'],
                    'before_node': baseline[mode]['Node Type'], 'after_node': proposed['Node Type'],
                    'uses_candidate': created['indexname'] in json.dumps(proposed)})
        except DatabaseError as error:
            evidence.append({'sample': sample['label'], 'error': error.sqlstate or 'unavailable'})
        finally:
            db.execute(f"ROLLBACK; DEALLOCATE ALL; SELECT {SCHEMA}.hypo_reset()")
    return evidence


def propose_indexes(db, qstats, deltas, policy):
    proposals = {}
    table_cache = {}
    costly = (r for r in deltas if r['calls'] >= MIN_CALLS and r['elapsed'] >= MIN_TOTAL_MS)
    for row in islice(costly, 30):
        for item in row['candidate_shape'] or candidate_shape(db, qstats, row):
            pair = item['schema'], item['table']
            if pair not in table_cache:
                table_cache[pair] = eligible_table(db, *pair)
            target = table_cache[pair]
            if not target or target['bytes'] < MIN_TABLE_BYTES or target['reltuples'] < MIN_ROWS:
                continue
            # Prefer queries that revisit a meaningful share of their table over the sample.
            if row['reads'] + row['hits'] < max(1000, target['relpages'] * 2):
                continue
            keys = table_keys(db, target, item)
            if not keys or covered(db, target['oid'], keys):
                continue
            sig = hashlib.sha256(json.dumps([*pair, keys], ensure_ascii=False).encode()).hexdigest()[:24]
            detail = proposals.setdefault((target['oid'], sig), dict(schema=pair[0], table=pair[1], keys=keys,
                                         index='pgis_' + sig, score=0, samples=[], advisory=True,
                                         estimated_table_bytes=target['bytes']))
            detail['advisory'] = detail['advisory'] and item.get('advisory', False)
            detail['score'] += row['elapsed']
            sample = {k: row[k] for k in ('userid', 'queryid', 'toplevel', 'calls', 'elapsed', 'reads', 'hits',
                                         'wal_bytes', 'sampled_epoch', 'period_seconds')}
            if sample not in detail['samples']:
                detail['samples'].append(sample)
    for position, ((target, sig), detail) in enumerate(rank_portfolio(proposals)):
        profile = db.one(f"""SELECT n_tup_ins,n_tup_upd,n_tup_del,n_tup_hot_upd
                         FROM pg_stat_user_tables WHERE relid={int(target)}""")
        detail['write_profile'] = profile
        if policy.get('use_hypopg') and position < 5 and not detail['advisory']:
            detail['plan_evidence'] = hypothetical_probe(db, detail)
            samples = measured_plans(db, target, detail)
            if samples:
                detail['plan_evidence']['registered_samples'] = samples
        if position < 10 and not detail['advisory']:
            detail['ddl_preview'], variants = advisory_variants(db, target, detail)
            for variant in variants:
                name = 'include' if 'include' in variant else 'partial'
                option = {**detail, **variant, 'advisory': True, 'plan_evidence': None}
                upsert_job(db, 'create', target, sig + ':' + name, option)
        upsert_job(db, 'create', target, sig, detail)


def index_inventory(db, index_oid=None, idle_days=IDLE_DAYS):
    return db.rows(f"""SELECT s.indexrelid AS oid, s.relid AS table_oid, s.schemaname AS schema,
                         s.relname AS table, s.indexrelname AS name, s.idx_scan AS scans,
                         pg_relation_size(s.indexrelid) AS bytes, pg_get_indexdef(s.indexrelid) AS ddl,
                         md5(concat_ws('|',pg_get_indexdef(s.indexrelid),ic.relfilenode::text,
                             s.relid::text)) AS fingerprint,
                         concat_ws('|',d.stats_reset::text,pg_postmaster_start_time()::text,
                                   to_jsonb(s)->>'stats_reset') AS reset_marker,
                         m.index_oid IS NOT NULL AND m.retired_at IS NULL AND
                           m.fingerprint=md5(concat_ws('|',pg_get_indexdef(s.indexrelid),
                                  ic.relfilenode::text,s.relid::text)) AS managed,
                         old.scans AS prior_scans, old.fingerprint AS prior_fingerprint,
                         old.reset_marker AS prior_reset, old.idle_since::text,
                         old.observed_at > clock_timestamp()-interval '{MAX_GAP_HOURS} hours' AS recent,
                         old.idle_since <= clock_timestamp()-make_interval(days=>{int(idle_days)}) AS idle_long,
                         i.indisvalid AND i.indisready AND i.indislive AS valid
                    FROM pg_stat_user_indexes s JOIN pg_index i ON i.indexrelid=s.indexrelid
                    JOIN pg_class ic ON ic.oid=i.indexrelid JOIN pg_class tc ON tc.oid=i.indrelid
                    JOIN pg_am am ON am.oid=ic.relam
                    JOIN pg_stat_database d ON d.datname=current_database()
                    LEFT JOIN {SCHEMA}.index_usage old ON old.index_oid=s.indexrelid
                    LEFT JOIN {SCHEMA}.managed_indexes m ON m.index_oid=s.indexrelid
                    WHERE tc.relkind='r' AND tc.relpersistence='p' AND NOT tc.relispartition
                      AND NOT tc.relrowsecurity AND ic.relkind='i' AND am.amname='btree'
                      AND NOT (i.indisunique OR i.indisprimary OR i.indisexclusion OR i.indisreplident OR i.indisclustered)
                      AND i.indpred IS NULL AND i.indexprs IS NULL
                      AND s.schemaname NOT IN ('information_schema','{SCHEMA}') AND s.schemaname !~ '^pg_'
                      AND NOT EXISTS (SELECT FROM pg_inherits h WHERE h.inhparent=s.relid OR h.inhrelid=s.relid)
                      AND NOT EXISTS (SELECT FROM pg_constraint co WHERE co.conindid=s.indexrelid)
                      AND NOT EXISTS (SELECT FROM pg_constraint fk WHERE fk.contype='f' AND fk.conrelid=s.relid
                          AND cardinality(fk.conkey) <= i.indnkeyatts AND fk.conkey <@ ARRAY(
                             SELECT key FROM unnest(i.indkey) WITH ORDINALITY k(key,pos)
                             WHERE k.pos <= cardinality(fk.conkey)))
                      AND NOT EXISTS (SELECT FROM pg_depend pd WHERE
                         (pd.classid='pg_class'::regclass AND pd.objid IN (s.relid,s.indexrelid) AND pd.deptype='e') OR
                         (pd.refclassid='pg_class'::regclass AND pd.refobjid=s.indexrelid))
                      {f'AND s.indexrelid={index_oid}' if index_oid is not None else ''}""")


def continuously_idle(idx):
    return (idx['recent'] and idx['scans'] == idx['prior_scans'] and
            idx['fingerprint'] == idx['prior_fingerprint'] and idx['reset_marker'] == idx['prior_reset'])


def observe_indexes(db, policy):
    batch = []
    for idx in index_inventory(db, idle_days=policy['idle_days']):
        if not idx['valid']:
            continue
        idle = continuously_idle(idx)
        since = literal(idx['idle_since']) + '::timestamptz' if idle else 'clock_timestamp()'
        batch.append(f"({idx['oid']},{literal(idx['fingerprint'])},{idx['scans']},clock_timestamp(),"
                     f"{since},{literal(idx['reset_marker'])})")
        if idle and idx['idle_long']:
            upsert_job(db, 'drop', idx['oid'], idx['fingerprint'],
                       {k: idx[k] for k in ('schema', 'table', 'name', 'ddl', 'bytes', 'scans', 'managed', 'idle_since')})
    for start in range(0, len(batch), 200):
        values = ','.join(batch[start:start + 200])
        db.execute(f"""INSERT INTO {SCHEMA}.index_usage VALUES {values}
                    ON CONFLICT(index_oid) DO UPDATE SET fingerprint=excluded.fingerprint,
                    scans=excluded.scans, observed_at=excluded.observed_at,
                    idle_since=excluded.idle_since, reset_marker=excluded.reset_marker""")


def propose_statistics(db, policy):
    if not policy['auto_analyze']:
        return
    candidates = db.rows(f"""SELECT relid,schemaname AS schema,relname AS table,n_mod_since_analyze
        FROM {SCHEMA}.table_health WHERE analyze_candidate
        ORDER BY n_mod_since_analyze DESC,relid LIMIT 10""")
    for row in candidates:
        if eligible_table(db, row['schema'], row['table']):
            upsert_job(db, 'analyze', row['relid'], 'analyze', row)


def observe_replicas(db, policy):
    services = set(policy['replica_services'])
    if not services:
        return set()
    identity = "SELECT system_identifier::text AS cluster,current_database() AS database FROM pg_control_system()"
    primary = db.one(identity)
    verified = set()
    for service in sorted(services):
        if not re.fullmatch(r'[a-zA-Z0-9_.-]{1,63}', service):
            event(db, 'replica_unavailable', reason='invalid_service')
            continue
        replica = None
        try:
            replica = Database(db.library, f'service={service} connect_timeout=3 target_session_attrs=standby')
            if replica.one(identity) != primary:
                event(db, 'replica_unavailable', reason='cluster_identity_mismatch')
                continue
            rows = replica.rows("""SELECT s.indexrelid AS oid,s.idx_scan AS scans,
                md5(concat_ws('|',pg_get_indexdef(s.indexrelid),c.relfilenode::text,s.relid::text)) AS fingerprint,
                concat_ws('|',d.stats_reset::text,pg_postmaster_start_time()::text,
                          to_jsonb(s)->>'stats_reset') AS reset_marker
                FROM pg_stat_user_indexes s JOIN pg_class c ON c.oid=s.indexrelid
                JOIN pg_stat_database d ON d.datname=current_database()""")
            for start in range(0, len(rows), 200):
                batch = rows[start:start + 200]
                values = ','.join(f"({literal(service)},{int(row['oid'])},{row['scans']},"
                                  f"{literal(row['fingerprint'])},{literal(row['reset_marker'])})" for row in batch)
                db.execute(f"""INSERT INTO {SCHEMA}.replica_usage AS old
                    (service,index_oid,scans,fingerprint,reset_marker,observed_at,idle_since)
                    SELECT service,oid::oid,scans,fingerprint,reset_marker,now(),now()
                    FROM (VALUES {values}) AS v(service,oid,scans,fingerprint,reset_marker)
                    ON CONFLICT (service,index_oid) DO UPDATE SET fingerprint=excluded.fingerprint,
                    scans=excluded.scans,reset_marker=excluded.reset_marker,observed_at=excluded.observed_at,
                    idle_since=CASE WHEN old.fingerprint=excluded.fingerprint AND old.scans=excluded.scans
                        AND old.reset_marker=excluded.reset_marker AND old.observed_at>now()-interval '24 hours'
                        THEN old.idle_since ELSE now() END""")
            verified.add(service)
        except (DatabaseError, OSError):
            event(db, 'replica_unavailable', reason='connection_or_statistics')
        finally:
            if replica:
                replica.close()
    return verified


def replica_allows_drop(db, idx, guards, policy):
    services = set(policy['replica_services'])
    if not services:
        return guards['no_replica_evidence']
    nodes = db.rows("SELECT application_name AS name FROM pg_stat_replication")
    if (services != guards['verified_replicas'] or not guards['replication_healthy'] or
            len(nodes) != len(services) or {row['name'] for row in nodes} != services):
        return False
    rows = db.rows(f"""SELECT service FROM {SCHEMA}.replica_usage
        WHERE index_oid={idx['oid']} AND fingerprint={literal(idx['fingerprint'])}
          AND observed_at>=now()-interval '5 minutes'
          AND idle_since<=now()-make_interval(days=>{int(policy['idle_days'])})""")
    return services.issubset({row['service'] for row in rows})


def observe_primary_epoch(db, policy):
    epoch = db.one("""SELECT left(pg_walfile_name(pg_current_wal_insert_lsn()),8) AS timeline""")['timeline']
    if epoch == policy['primary_epoch']:
        return db.one(f"SELECT primary_epoch_at+make_interval(secs=>failover_grace_seconds)"
                      f" <= now() AS ready FROM {SCHEMA}.policy WHERE singleton")['ready']
    if policy['primary_epoch'] is None:
        db.execute(f"UPDATE {SCHEMA}.policy SET primary_epoch={literal(epoch)},"
                   "primary_epoch_at='-infinity' WHERE singleton")
        return True
    db.execute(f"""BEGIN;
        UPDATE {SCHEMA}.policy SET primary_epoch={literal(epoch)},primary_epoch_at=now() WHERE singleton;
        DELETE FROM {SCHEMA}.replica_usage;
        UPDATE {SCHEMA}.index_usage SET idle_since=now();
        DELETE FROM {SCHEMA}.workload;
        COMMIT""")
    event(db, 'primary_epoch_changed', reason='timeline_changed')
    return policy['failover_grace_seconds'] == 0


def protect(db, job):
    target = int(job['target'])
    return db.one(f"""SELECT NOT EXISTS (SELECT FROM pg_stat_activity a
                  WHERE a.pid<>pg_backend_pid() AND a.xact_start<clock_timestamp()-interval '5 minutes'
                    AND (a.backend_xmin IS NOT NULL OR EXISTS (SELECT FROM pg_locks l WHERE l.pid=a.pid
                        AND l.database=(SELECT oid FROM pg_database WHERE datname=current_database())
                        AND l.relation IN ({target},(SELECT indrelid FROM pg_index WHERE indexrelid={target})))))
                  AS no_long_xact,
                  NOT EXISTS (SELECT FROM pg_stat_replication WHERE state<>'streaming'
                    OR COALESCE(pg_wal_lsn_diff(pg_current_wal_lsn(),replay_lsn),1e20)>67108864)
                  AS replication_healthy,
                  NOT EXISTS (SELECT FROM pg_stat_replication) AND
                  NOT EXISTS (SELECT FROM pg_replication_slots) AS no_replica_evidence""")


def event(db, name, job=None, reason=None, retry_at=None):
    db.execute(f"SELECT {SCHEMA}.log_event({literal(name)},{job['id'] if job else 'NULL'},"
               f"{literal(job['action'] if job else None)},{literal(reason)},{literal(retry_at)})")


def update_job(db, job, state, message, reason=None):
    db.execute(f"""WITH changed AS (UPDATE {SCHEMA}.jobs SET state={literal(state)},message={literal(message)},
                   reason={literal(reason)},
                   attempts=attempts+CASE WHEN {literal(state)}='running' THEN 1 ELSE 0 END,
                   retry_streak=retry_streak+CASE WHEN {literal(state)}='running' THEN 1 ELSE 0 END,
                   last_started_at=CASE WHEN {literal(state)}='running' THEN clock_timestamp() ELSE last_started_at END,
                   updated_at=clock_timestamp() WHERE id={job['id']} RETURNING id,attempts)
                   INSERT INTO {SCHEMA}.attempts(job_id,attempt)
                   SELECT id,attempts FROM changed WHERE {literal(state)}='running'""")
    event(db, state, job, reason)


def defer_job(db, job, reason, policy, attempted=False):
    streak = job['retry_streak'] + int(attempted)
    if attempted and streak >= policy['retry_limit']:
        update_job(db, job, 'failed', f'Retry limit reached ({reason})', 'retry_limit')
        return
    base = {'55P03': 30, '40P01': 60, 'disk_headroom': 300, '53100': 300,
            'replication_lag': 180, '57014': 180}.get(reason, 120)
    delay = min(3600, base * (2 ** min(streak, 5)))
    rows = db.execute(f"""WITH deferred AS (UPDATE {SCHEMA}.jobs SET state='queued',
                   message={literal(reason)},reason={literal(reason)},
                   next_attempt_at=clock_timestamp()+make_interval(secs=>{delay}) WHERE id={job['id']}
                   RETURNING next_attempt_at::text AS retry_at) SELECT retry_at FROM deferred""")
    event(db, 'deferred', job, reason, rows[0])


def reserve_next_window(db, job, cfg):
    start = cfg['maintenance_window'].split('-')[0]
    retry = db.execute(f"""WITH timing AS (
        SELECT current_date + {literal(start)}::time AS boundary, localtimestamp AS current_time
    ), saved AS (
        UPDATE {SCHEMA}.jobs SET reason='window_capacity',message='Waiting for enough time in the next window',
        next_attempt_at=(SELECT (boundary + CASE WHEN boundary<=current_time THEN interval '1 day'
                             ELSE interval '0' END) AT TIME ZONE current_setting('TimeZone') FROM timing)
        WHERE id={job['id']} RETURNING next_attempt_at::text
    ) SELECT next_attempt_at FROM saved""")
    event(db, 'deferred', job, 'window_capacity', retry[0])


def retryable(error):
    return error.sqlstate in ('55P03', '57014', '40P01', '40001', '53100')


def ddl_budget(db, policy, job):
    cfg = settings(db)
    current = db.one(f"SELECT * FROM {SCHEMA}.policy WHERE singleton")
    seconds = seconds_remaining(cfg['maintenance_window'], cfg['local_time'])
    required = min(job['required_seconds'], current['ddl_timeout_seconds'] + 5) if current else MIN_DDL_WINDOW_SECONDS
    if 0 < seconds < required:
        reserve_next_window(db, job, cfg)
        return 0
    managed = job['detail'].get('managed')
    drop_enabled = (job['detail'].get('rollback') or
                    cfg['auto_drop_managed' if managed else 'auto_drop_existing'])
    enabled = cfg['auto_create'] if job['action'] == 'create' else drop_enabled
    if job['action'] == 'analyze':
        enabled = current and current.get('auto_analyze')
    if (not current or current['paused'] or seconds < MIN_DDL_WINDOW_SECONDS or
            not enabled or not allowed_by_policy(job, current)):
        defer_job(db, job, 'window_or_policy_changed', policy)
        return 0
    # Give a timed-out build another chance with a larger budget, subject to
    # both the operator's ceiling and the time left in the current window.
    timeout = min(current['ddl_timeout_seconds'], 1800 * (2 ** min(job['retry_streak'], 3)))
    return min(seconds - 5, timeout)


def fetch_index(db, schema, name, table_oid):
    return db.one(f"""SELECT ic.oid, i.indisvalid AS valid, i.indisready AS ready,
                     pg_get_indexdef(ic.oid) AS ddl,
                     md5(concat_ws('|',pg_get_indexdef(ic.oid),ic.relfilenode::text,i.indrelid::text)) AS fingerprint
                FROM pg_class ic JOIN pg_namespace n ON n.oid=ic.relnamespace
                JOIN pg_index i ON i.indexrelid=ic.oid
                WHERE n.nspname={literal(schema)} AND ic.relname={literal(name)} AND i.indrelid={table_oid}""")


def repair_build_residue(db, job, index, cfg, policy):
    marker = job['pending_cleanup']
    if not marker or not index or index['valid'] or any(index[key] != marker[key] for key in ('oid','fingerprint')):
        update_job(db, job, 'failed', 'Manual review of index identity required', 'index_name_conflict')
        return False
    if not ddl_budget(db, policy, job):
        return False
    detail = job['detail']
    try:
        db.execute("SET statement_timeout='15s'")
        db.execute(f"DROP INDEX CONCURRENTLY {relation(detail['schema'],detail['index'])}")
        db.execute(f"UPDATE {SCHEMA}.jobs SET pending_cleanup=NULL,next_attempt_at='-infinity' WHERE id={job['id']}")
        event(db, 'cleanup_completed', job, 'owned_invalid_index')
        return True
    except DatabaseError as error:
        defer_job(db, job, error.sqlstate or 'invalid_index_cleanup', policy)
        return False


def partition_children(db, parent):
    return db.rows(f"""SELECT c.oid,n.nspname AS schema,c.relname AS table,c.relkind,
        c.relpersistence,c.relrowsecurity,c.reltablespace::bigint AS reltablespace,pg_relation_size(c.oid) AS bytes
        FROM pg_inherits h JOIN pg_class c ON c.oid=h.inhrelid
        JOIN pg_namespace n ON n.oid=c.relnamespace WHERE h.inhparent={parent}
        ORDER BY c.oid""")


def queue_partition_repairs(db, policy):
    if not policy['auto_resume_partitions']:
        return
    jobs = db.rows(f"""SELECT j.target,j.signature,j.detail
        FROM {SCHEMA}.partition_index_progress p JOIN {SCHEMA}.jobs j ON j.id=p.id
        WHERE j.state='done' AND p.indisvalid=false AND p.attached_indexes<p.partitions
          AND NOT EXISTS (SELECT FROM {SCHEMA}.jobs newer WHERE newer.id>j.id
                          AND newer.target=j.target AND newer.signature=j.signature)
        ORDER BY j.id LIMIT 20""")
    for job in jobs:
        upsert_job(db, 'create', job['target'], job['signature'], job['detail'])


def partition_step(db, job, cfg, remaining, policy):
    detail = job['detail']
    target = job['target']
    parent = db.one(f"""SELECT c.oid FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace
        WHERE c.oid={target} AND c.relname={literal(detail['table'])} AND n.nspname={literal(detail['schema'])}
          AND c.relkind='p' AND NOT c.relispartition AND NOT c.relrowsecurity""")
    if not parent or extension_managed(db, target, detail['schema'], detail['table']):
        update_job(db, job, 'cancelled', 'Partitioned table identity changed', 'partition_identity')
        return False
    children = partition_children(db, target)
    if not children or any(child['relkind'] != 'r' or child['relpersistence'] != 'p' or
                           child['relrowsecurity'] or child['reltablespace'] or
                           not allowed_by_policy({'detail': child}, policy) for child in children):
        update_job(db, job, 'failed', 'Requires one level of permanent ordinary partitions', 'partition_shape')
        return False
    qualified = relation(detail['schema'], detail['table'])
    columns = ', '.join(identifier(name) for name in detail['keys'])
    index_name = relation(detail['schema'], detail['index'])
    index = fetch_index(db, detail['schema'], detail['index'], target)
    if index and index['valid']:
        update_job(db, job, 'done', 'Parent index is valid', 'partition_complete')
        return False
    if index is None and covered(db, target, detail['keys']):
        update_job(db, job, 'cancelled', 'A parent index covers the candidate', 'already_covered')
        return False
    if index is None:
        if any(child['bytes'] > policy['max_table_bytes'] for child in children):
            defer_job(db, job, 'partition_size_policy', policy)
            return False
        sql = f"CREATE INDEX {identifier(detail['index'])} ON ONLY {qualified} USING btree ({columns})"
        stage = 'partition_parent'
    else:
        attached = {r['table_oid'] for r in db.rows(f"""SELECT i.indrelid AS table_oid
            FROM pg_inherits h JOIN pg_index i ON i.indexrelid=h.inhrelid WHERE h.inhparent={index['oid']}""")}
        child = next((row for row in children if row['oid'] not in attached), None)
        if child is None:
            defer_job(db, job, 'partition_catalog_changed', policy)
            return False
        child_name = f"{detail['index']}_{child['oid']}"
        child_index = fetch_index(db, child['schema'], child_name, child['oid'])
        if child_index and not child_index['valid']:
            update_job(db, job, 'failed', 'Inspect invalid partition index before retry', 'partition_child_invalid')
            return False
        if child_index:
            sql = f"ALTER INDEX {index_name} ATTACH PARTITION {relation(child['schema'], child_name)}"
            stage = 'partition_attached'
        else:
            if child['bytes'] > policy['max_table_bytes']:
                defer_job(db, job, 'partition_size_policy', policy)
                return False
            reserve = max(policy['min_free_bytes'], 2 * child['bytes'])
            if shutil.disk_usage(cfg['data_directory']).free < reserve:
                defer_job(db, job, 'disk_headroom', policy)
                return False
            sql = (f"CREATE INDEX CONCURRENTLY {identifier(child_name)} ON "
                   f"{relation(child['schema'], child['table'])} USING btree ({columns})")
            stage = 'partition_child'
    budget = ddl_budget(db, policy, job)
    if not budget:
        return False
    update_job(db, job, 'running', 'Partition index step started', stage)
    try:
        db.execute(f"SET statement_timeout='{budget}s'")
        db.execute(sql)
        db.execute(f"UPDATE {SCHEMA}.jobs SET state='queued',reason={literal(stage)},"
                   f"retry_streak=0,next_attempt_at='-infinity' WHERE id={job['id']}")
        event(db, 'step_completed', job, stage)
    except DatabaseError as error:
        if retryable(error):
            defer_job(db, job, error.sqlstate, policy, attempted=True)
        else:
            update_job(db, job, 'failed', 'Partition index step failed', error.sqlstate)
    finally:
        db.execute("SET statement_timeout='15s'")
    return True


def create_index(db, job, cfg, remaining, policy):
    detail = job['detail']
    if detail.get('partition'):
        return partition_step(db, job, cfg, remaining, policy)
    tbl = eligible_table(db, detail['schema'], detail['table'])
    if not tbl or tbl['oid'] != job['target'] or covered(db, tbl['oid'], detail['keys']):
        update_job(db, job, 'cancelled', 'Table changed or an index now covers the candidate')
        return False
    if tbl['bytes'] < MIN_TABLE_BYTES or tbl['reltuples'] < MIN_ROWS or tbl['bytes'] > policy['max_table_bytes']:
        defer_job(db, job, 'table_size_policy', policy)
        return False
    reserve = max(policy['min_free_bytes'], 2 * tbl['bytes'])
    if shutil.disk_usage(cfg['data_directory']).free < reserve:
        defer_job(db, job, 'disk_headroom', policy)
        return False
    other = db.one(f"""SELECT EXISTS(SELECT FROM pg_stat_progress_create_index WHERE relid={tbl['oid']}) AS active""")
    if other['active']:
        defer_job(db, job, 'concurrent_build', policy)
        return False
    previous = fetch_index(db, detail['schema'], detail['index'], tbl['oid'])
    if previous:
        if job['pending_cleanup']:
            return repair_build_residue(db, job, previous, cfg, policy)
        update_job(db, job, 'failed', 'Generated index already exists; inspect its definition', 'index_name_conflict')
        return False
    qualified = relation(detail['schema'], detail['table'])
    columns = ', '.join(identifier(x) for x in detail['keys'])
    ddl = f"CREATE INDEX CONCURRENTLY {identifier(detail['index'])} ON {qualified} USING btree ({columns})"
    budget = ddl_budget(db, policy, job)
    if not budget:
        return False
    update_job(db, job, 'running', 'Concurrent create started')
    try:
        db.execute(f"SET statement_timeout='{budget}s'")
        db.execute(ddl)
        idx = fetch_index(db, detail['schema'], detail['index'], tbl['oid'])
        if not idx or not idx['valid'] or not idx['ready']:
            raise DatabaseError('Expected valid index missing after DDL')
        db.execute(f"""WITH managed AS (
                        INSERT INTO {SCHEMA}.managed_indexes(index_oid,table_oid,fingerprint,ddl,build_job)
                        VALUES ({idx['oid']},{tbl['oid']},{literal(idx['fingerprint'])},{literal(idx['ddl'])},{job['id']})
                        RETURNING index_oid)
                        INSERT INTO {SCHEMA}.verdicts(job_id,index_oid,index_fingerprint,baseline)
                        SELECT {job['id']}, index_oid,{literal(idx['fingerprint'])},{json_value(detail['samples'])} FROM managed
                        ON CONFLICT (job_id) DO UPDATE SET index_oid=excluded.index_oid,
                            index_fingerprint=excluded.index_fingerprint,baseline=excluded.baseline,
                            observations='[]',state='observing',updated_at=clock_timestamp()""")
        update_job(db, job, 'done', 'Index valid; observing natural traffic')
    except DatabaseError as exc:
        idx = fetch_index(db, detail['schema'], detail['index'], tbl['oid'])
        if retryable(exc) and idx and not idx['valid'] and exc.sqlstate in ('55P03','57014','53100'):
            marker = {name: idx[name] for name in ('oid','fingerprint')}
            db.execute(f"UPDATE {SCHEMA}.jobs SET pending_cleanup={json_value(marker)} WHERE id={job['id']}")
            event(db, 'cleanup_queued', job, 'invalid_concurrent_build')
        if exc.sqlstate == '57014':
            db.execute(f"UPDATE {SCHEMA}.jobs SET required_seconds=GREATEST(required_seconds,"
                       f"{min(policy['ddl_timeout_seconds'] + 5, budget * 2 + 5)}) WHERE id={job['id']}")
        if retryable(exc) and (not idx or not idx['valid']):
            defer_job(db, job, exc.sqlstate, policy, attempted=True)
        else:
            update_job(db, job, 'failed', f'Create failed ({exc.sqlstate or "unknown"})',
                       'invalid_index' if idx else exc.sqlstate)
    finally:
        db.execute("SET statement_timeout='15s'")
    return True


def analyze_table(db, job, policy):
    detail = job['detail']
    target = eligible_table(db, detail['schema'], detail['table'])
    if not target or target['oid'] != job['target']:
        update_job(db, job, 'cancelled', 'Table identity changed', 'table_identity')
        return False
    health = db.one(f"SELECT analyze_candidate FROM {SCHEMA}.table_health WHERE relid={int(job['target'])}")
    if not health or not health['analyze_candidate']:
        update_job(db, job, 'cancelled', 'Statistics already fresh', 'statistics_fresh')
        return False
    if target['bytes'] > policy['max_table_bytes']:
        defer_job(db, job, 'table_size_policy', policy)
        return False
    budget = ddl_budget(db, policy, job)
    if not budget:
        return False
    update_job(db, job, 'running', 'Refreshing table statistics')
    try:
        db.execute(f"SET statement_timeout='{budget}s'")
        db.execute(f"ANALYZE {relation(detail['schema'], detail['table'])}")
        update_job(db, job, 'done', 'Table statistics refreshed', 'statistics_refreshed')
    except DatabaseError as error:
        if retryable(error):
            defer_job(db, job, error.sqlstate, policy, attempted=True)
        else:
            update_job(db, job, 'failed', 'ANALYZE failed', error.sqlstate)
    finally:
        db.execute("SET statement_timeout='15s'")
    return True


def drop_index(db, job, cfg, guards, remaining, policy):
    rows = index_inventory(db, job['target'], policy['idle_days'])
    if not rows or rows[0]['fingerprint'] != job['signature']:
        update_job(db, job, 'cancelled', 'Index identity or dependencies changed')
        return False
    idx = rows[0]
    held = db.one(f"SELECT EXISTS(SELECT FROM {SCHEMA}.retention_policy WHERE index_oid={int(idx['oid'])}"
                  f" AND definition={literal(idx['ddl'])} AND preserve_until>now()) AS held")
    if held['held']:
        defer_job(db, job, 'retention_policy', policy)
        return False
    rollback = job['detail'].get('rollback', False)
    if extension_managed(db, idx['table_oid'], idx['schema'], idx['table']):
        update_job(db, job, 'cancelled', 'Table is managed by another extension')
        return False
    permitted = idx['managed'] if rollback else (cfg['auto_drop_managed'] if idx['managed'] else cfg['auto_drop_existing'])
    if not permitted or not replica_allows_drop(db, idx, guards, policy):
        defer_job(db, job, 'drop_disabled' if not permitted else 'replica_usage_unverified', policy)
        return False
    if not idx['valid'] or (not rollback and (not continuously_idle(idx) or not idx['idle_long'])):
        update_job(db, job, 'cancelled', 'Idle evidence no longer qualifies')
        return False
    # Persist recreatable DDL before executing the nontransactional operation.
    budget = ddl_budget(db, policy, job)
    if not budget:
        return False
    update_job(db, job, 'running', 'Concurrent drop started')
    try:
        db.execute(f"SET statement_timeout='{budget}s'")
        db.execute(f"DROP INDEX CONCURRENTLY {relation(idx['schema'],idx['name'])}")
        db.execute(f"""UPDATE {SCHEMA}.managed_indexes SET retired_at=clock_timestamp()
                       WHERE index_oid={idx['oid']} AND fingerprint={literal(idx['fingerprint'])}""")
        update_job(db, job, 'done', 'Index retired; original DDL retained in detail', 'rollback' if rollback else 'idle')
        if rollback:
            db.execute(f"""UPDATE {SCHEMA}.verdicts SET state='rolled_back',updated_at=clock_timestamp()
                           WHERE index_oid={idx['oid']} AND index_fingerprint={literal(idx['fingerprint'])}""")
            db.execute(f"""UPDATE {SCHEMA}.policy SET paused=true WHERE singleton""")
            event(db, 'cycle_paused', job, 'rollback_completed')
    except DatabaseError as exc:
        current = index_inventory(db, job['target'])
        if retryable(exc) and current and current[0]['valid']:
            defer_job(db, job, exc.sqlstate, policy, attempted=True)
        else:
            update_job(db, job, 'failed', f'Drop failed ({exc.sqlstate or "unknown"})', exc.sqlstate)
    finally:
        db.execute("SET statement_timeout='15s'")
    return True


def measure(db, deltas, policy):
    lookup = {(x['userid'], x['queryid'], x['toplevel']): x for x in deltas}
    for row in db.rows(f"SELECT * FROM {SCHEMA}.verdicts WHERE state='observing' AND baseline<>'[]'::jsonb "
                       "ORDER BY updated_at,job_id LIMIT 30"):
        baseline = row['baseline']
        history = row['observations']
        for item in baseline:
            k = item['userid'], item['queryid'], item['toplevel']
            sample = lookup.get(k)
            if sample:
                history.append({name: sample[name] for name in ('userid','queryid','toplevel','calls','elapsed','reads','hits','wal_bytes',
                                                                 'sampled_epoch','period_seconds')})
        results = []
        strong_regression = []
        comparison = []
        for item in baseline:
            selected = [x for x in history if all(x[key] == item[key] for key in ('userid','queryid','toplevel'))]
            if item.get('period_seconds', 0) > 0:
                rate = item['calls'] / item['period_seconds']
                selected = [x for x in selected if x.get('period_seconds', 0) > 0 and
                            rate / 4 <= x['calls'] / x['period_seconds'] <= rate * 4]
            calls = sum(x['calls'] for x in selected)
            if calls >= OBS_MIN_CALLS and len(selected) >= 3:
                observed = sum(x['elapsed'] for x in selected) / calls
                original = item['elapsed'] / item['calls']
                if original <= 0:
                    continue
                ratio = observed / original
                results.append(ratio)
                blocks_old = (item['hits'] + item['reads']) / item['calls']
                blocks_new = sum(x['hits'] + x['reads'] for x in selected) / calls
                strong_regression.append(ratio >= 2 and blocks_old > 0 and blocks_new >= blocks_old * 1.5)
                result = {'queryid': item['queryid'], 'mean_ratio': ratio, 'calls': calls,
                          'mean_blocks_before': blocks_old, 'mean_blocks_after': blocks_new,
                          'wal_bytes_per_call_before': item.get('wal_bytes', 0) / item['calls'],
                          'wal_bytes_per_call_after': sum(x.get('wal_bytes', 0) for x in selected) / calls}
                if item.get('sampled_epoch') and all(x.get('sampled_epoch') for x in selected):
                    for name, stamp in [('baseline',item['sampled_epoch']),('observed',selected[-1]['sampled_epoch'])]:
                        metric = db.one(f"SELECT p95_ms FROM {SCHEMA}.latency_samples WHERE queryid={item['queryid']} "
                                        f"AND sampled_at BETWEEN to_timestamp({stamp})-interval '15 minutes' AND to_timestamp({stamp}) "
                                        'AND calls>=100 ORDER BY sampled_at DESC LIMIT 1')
                        if metric:
                            result[f'{name}_p95_ms'] = metric['p95_ms']
                comparison.append(result)
        state = 'observing'
        if results and len(results) == len(baseline):
            state = 'regression_review' if max(results) > 1.20 else ('improved' if max(results) <= 0.80 else 'mixed')
        db.execute(f"""UPDATE {SCHEMA}.verdicts SET observations={json_value(history[-300:])},
                       comparison={json_value(comparison)},state={literal(state)},
                       updated_at=clock_timestamp() WHERE job_id={row['job_id']}""")
        if state != 'observing':
            event(db, 'verdict', {'id': row['job_id'], 'action': 'create'}, state)
        if state == 'regression_review' and policy.get('auto_rollback') and all(strong_regression):
            indexes = index_inventory(db, row['index_oid'])
            if indexes and indexes[0]['managed'] and indexes[0]['scans'] >= 100:
                db.execute(f"SELECT {SCHEMA}.approve_rollback({row['job_id']})")


def allowed_by_policy(job, policy):
    obj = job['detail']
    schema, table = obj.get('schema'), obj.get('table')
    if not isinstance(schema, str) or not isinstance(table, str):
        return False
    schemas, tables = policy['allowed_schemas'], policy['allowed_tables']
    return ((schemas is None or schema in schemas) and
            (tables is None or relation(schema, table) in tables))


def recover_jobs(db, policy):
    for job in db.rows(f"SELECT * FROM {SCHEMA}.jobs WHERE state='running'"):
        detail = job['detail']
        if job['action'] == 'analyze':
            defer_job(db, job, 'interrupted_analyze', policy)
            continue
        if detail.get('partition'):
            defer_job(db, job, 'interrupted_partition_step', policy)
            continue
        if job['action'] == 'create':
            idx = fetch_index(db, detail['schema'], detail['index'], job['target'])
            if idx is None:
                defer_job(db, job, 'interrupted_before_create', policy)
                continue
            if idx['valid'] and db.one(f"SELECT EXISTS(SELECT FROM {SCHEMA}.managed_indexes WHERE build_job={job['id']}) AS recorded")['recorded']:
                update_job(db, job, 'done', 'Recovered recorded index', 'reconciled')
                continue
        else:
            obj = db.one(f"SELECT EXISTS(SELECT FROM pg_class WHERE oid={job['target']}) AS present")
            if not obj['present']:
                db.execute(f"UPDATE {SCHEMA}.managed_indexes SET retired_at=clock_timestamp() WHERE index_oid={job['target']}")
                update_job(db, job, 'done', 'Recovered completed drop', 'reconciled')
                continue
            rows = index_inventory(db, job['target'])
            if rows and rows[0]['valid'] and rows[0]['fingerprint'] == job['signature']:
                defer_job(db, job, 'interrupted_before_drop', policy)
                continue
        update_job(db, job, 'failed', 'DDL interrupted; inspect object before retry', 'interrupted_catalog_review')


def run_cycle(db, cfg, allow_ddl):
    if cfg['recovery'] or cfg['read_only']:
        return
    datadir = Path(cfg['data_directory'])
    if not (datadir / 'PG_VERSION').is_file():
        raise DatabaseError('Use the runner on the PostgreSQL host with its data directory mounted')
    with (datadir / '.pg-index-steward.lock').open('a') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        qstats, info = extension_locations(db)
        policy = db.one(f"SELECT * FROM {SCHEMA}.policy WHERE singleton")
        if policy is None:
            raise DatabaseError('Missing index_steward.policy row')
        if not db.one("SELECT pg_try_advisory_lock(1885825395,176884235) AS held")['held']:
            return
        primary_ready = observe_primary_epoch(db, policy)
        recover_jobs(db, policy)
        deltas = workload(db, qstats, info)
        record_diagnostics(db, qstats, deltas)
        propose_indexes(db, qstats, deltas, policy)
        queue_partition_repairs(db, policy)
        propose_statistics(db, policy)
        observe_indexes(db, policy)
        verified_replicas = observe_replicas(db, policy)
        measure(db, deltas, policy)
        if not allow_ddl or policy['paused']:
            return
        if not primary_ready:
            event(db, 'cycle_waiting', reason='failover_grace')
            return
        cfg = settings(db)
        remaining = seconds_remaining(cfg['maintenance_window'], cfg['local_time'])
        if remaining < MIN_DDL_WINDOW_SECONDS:
            if db.one(f"SELECT EXISTS(SELECT FROM {SCHEMA}.jobs WHERE state='queued' AND NOT COALESCE((detail->>'advisory')::boolean,false)) AS pending")['pending']:
                event(db, 'cycle_waiting', reason='maintenance_window')
            return
        used = db.one(f"SELECT count(*) AS jobs FROM {SCHEMA}.attempts WHERE started_at >= date_trunc('day',clock_timestamp())")
        if used['jobs'] >= policy['daily_limit']:
            event(db, 'cycle_paused', reason='daily_limit')
            return
        jobs = db.rows(f"""SELECT * FROM {SCHEMA}.jobs WHERE state='queued'
                       AND next_attempt_at<=clock_timestamp()
                       AND NOT COALESCE((detail->>'advisory')::boolean,false)
                       AND (action<>'create' OR COALESCE((detail->>'partition')::boolean,false)
                           OR evidence_at>clock_timestamp()-interval '7 days')
                       AND (action<>'create' OR {literal(cfg['auto_create'])})
                       AND (action<>'analyze' OR {literal(policy['auto_analyze'])})
                       AND (action<>'drop' OR COALESCE((detail->>'rollback')::boolean,false)
                           OR CASE WHEN COALESCE((detail->>'managed')::boolean,false)
                                   THEN {literal(cfg['auto_drop_managed'])} ELSE {literal(cfg['auto_drop_existing'])} END)
                       ORDER BY COALESCE((detail->>'rollback')::boolean,false) DESC,
                                (created_at<clock_timestamp()-interval '2 days') DESC,
                                CASE WHEN created_at<clock_timestamp()-interval '2 days' THEN created_at END,
                                action='create' DESC, COALESCE((detail->>'score')::float8, 0) DESC,id LIMIT 50""")
        for job in jobs:
            cfg = settings(db)
            remaining = seconds_remaining(cfg['maintenance_window'], cfg['local_time'])
            if remaining < MIN_DDL_WINDOW_SECONDS:
                return
            if not allowed_by_policy(job, policy):
                defer_job(db, job, 'outside_allowlist', policy)
                continue
            guards = protect(db, job)
            guards['verified_replicas'] = verified_replicas
            if not guards['no_long_xact'] or not guards['replication_healthy']:
                reason = 'long_transaction' if not guards['no_long_xact'] else 'replication_lag'
                defer_job(db, job, reason, policy)
                continue
            if job['action'] == 'create':
                if not cfg['auto_create']:
                    defer_job(db, job, 'create_disabled', policy)
                elif create_index(db, job, cfg, remaining, policy):
                    return
            elif job['action'] == 'drop':
                if drop_index(db, job, cfg, guards, remaining, policy):
                    return
            elif job['action'] == 'analyze' and analyze_table(db, job, policy):
                return


def report(db, as_metrics=False, service=None, headers=True):
    rows = db.rows(f'SELECT * FROM {SCHEMA}.status() ORDER BY action,state,reason')
    if not as_metrics:
        return rows
    def label(value):
        return str(value or '').replace('\\', '\\\\').replace('"', '\\"').replace('\n', '\\n')

    def labels(row, keys):
        return ','.join([f'service="{label(service)}"', *(f'{key}="{label(row[key])}"' for key in keys)])

    if headers:
        print('# TYPE pg_index_steward_paused gauge')
        print('# TYPE pg_index_steward_jobs gauge')
        print('# TYPE pg_index_steward_oldest_job_seconds gauge')
    if rows:
        cluster = labels(rows[0], ('database_name', 'version'))
        print(f'pg_index_steward_paused{{{cluster}}} {int(rows[0]["paused"])}')
    for row in rows:
        if not row['action']:
            continue
        keys = labels(row, ('database_name', 'action', 'state', 'reason'))
        print(f'pg_index_steward_jobs{{{keys}}} {row["jobs"]}')
        print(f'pg_index_steward_oldest_job_seconds{{{keys}}} {row["oldest_job_seconds"]}')
    return None


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--libpq', default=os.environ.get('PGSTEWARD_LIBPQ', 'libpq.so.5'))
    parser.add_argument('--conninfo', default='')
    parser.add_argument('--interval', type=int, default=900)
    parser.add_argument('--once', action='store_true')
    parser.add_argument('--observe-only', action='store_true')
    parser.add_argument('--service', action='append', help='libpq service name for read-only status or metrics; repeat for multiple instances')
    output = parser.add_mutually_exclusive_group()
    output.add_argument('--status', action='store_true')
    output.add_argument('--metrics', action='store_true')
    args = parser.parse_args()
    if args.status or args.metrics:
        if args.service and args.conninfo:
            parser.error('--service and --conninfo are mutually exclusive')
        aggregate = []
        for position, service in enumerate(dict.fromkeys(args.service or [None])):
            if service is not None and not re.fullmatch(r'[a-zA-Z0-9_.-]{1,63}', service):
                parser.error('Invalid libpq service name')
            db = None
            try:
                db = Database(args.libpq, f'service={service} connect_timeout=5' if service else args.conninfo)
                rows = report(db, args.metrics, service, headers=position == 0)
                if rows is not None:
                    aggregate.append({'service': service, 'status': rows})
            except (DatabaseError, OSError) as exc:
                print(f'Status query failed ({getattr(exc, "sqlstate", None) or type(exc).__name__})', file=sys.stderr)
                return 1
            finally:
                if db:
                    db.close()
        if not args.metrics:
            print(json.dumps(aggregate, indent=2, ensure_ascii=False))
        return 0
    if args.service:
        parser.error('--service requires --status or --metrics')
    if not args.once and args.interval < 60:
        parser.error('--interval must be at least 60 seconds')
    while True:
        db = None
        try:
            db = Database(args.libpq, args.conninfo)
            run_cycle(db, settings(db), not args.observe_only)
        except (DatabaseError, OSError, ValueError) as exc:
            reason = getattr(exc, 'sqlstate', None) or type(exc).__name__
            if db:
                try:
                    event(db, 'cycle_failed', reason=reason)
                except DatabaseError:
                    pass
            print(f'{dt.datetime.now().isoformat(timespec="seconds")} stewardship cycle failed ({reason})', file=sys.stderr)
            if args.once:
                return 1
        finally:
            if db:
                db.close()
        if args.once:
            return 0
        time.sleep(args.interval)


if __name__ == '__main__':
    sys.exit(main())
